// Contact form API only. The website is on GitHub Pages (see .github/workflows/pages.yml).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "virtualline-contact",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "send_email": [
    { "name": "CONTACT_EMAIL", "destination_address": "virtualline35@gmail.com" }
  ],
  "routes": [
    { "pattern": "api.ahylon.co.uk", "custom_domain": true },
    { "pattern": "api.virtualine.co.uk", "custom_domain": true },
    { "pattern": "api.virtualline.co.uk", "custom_domain": true }
  ],
  // "Ask Ahylon" chat: at most 12 messages a minute from one visitor (src/chat.js).
  // The Claude API key is a secret, set once with:  npx wrangler secret put ANTHROPIC_API_KEY
  "ratelimits": [
    { "name": "CHAT_LIMIT", "namespace_id": "1001", "simple": { "limit": 12, "period": 60 } }
  ],
  "vars": { "CHAT_MODEL": "claude-haiku-5-5" },
  "observability": { "enabled": true }
}
